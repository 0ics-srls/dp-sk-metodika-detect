{
  "specVersion": "1.1",
  "type": "stdin",
  "name": "dp-sk-metodika-detect",
  "version": "0.1.0",
  "description": "Turns a sk-metodika Source config (Financna sprava sections, MF SR year pages, NBS, UVO leaves) into catalog items. No network. Proc-protocol v1.1: spec, check, run.",
  "author": "open-lex-it",
  "authentication": false,
  "actions": {
    "spec": {
      "description": "Return the config and output JSON schemas (Proc-protocol 1.1).",
      "input": { "type": "object", "properties": {} },
      "output": {
        "type": "object",
        "properties": {
          "configSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "protocol": { "type": "string", "const": "1.1" }
        }
      }
    },
    "check": {
      "description": "Test Source: validates the config (exactly one of sections or sites, year range, sample filters). No request is made; grab checks that a listing exists.",
      "input": { "type": "object", "properties": {} },
      "output": { "type": "object", "properties": { "ok": { "type": "boolean" } } }
    },
    "run": {
      "description": "Items are the sections, year pages, sites or UVO leaves whose key is not in state.seen; a refreshToken change re-emits every item.",
      "input": {
        "type": "object",
        "properties": {
          "sections": { "type": ["array", "null"], "items": { "type": "string" } },
          "sites": { "type": ["array", "null"], "items": { "type": "string" } },
          "annoFrom": { "type": ["integer", "null"] },
          "annoTo": { "type": ["integer", "null"] },
          "uvoRobotsAck": { "type": ["boolean", "null"] },
          "only": { "type": ["array", "null"] },
          "maxDocs": { "type": ["integer", "null"] },
          "baseUrl": { "type": ["string", "null"] },
          "delaySeconds": { "type": ["number", "null"] },
          "verifyTls": { "type": ["boolean", "null"] },
          "refreshToken": { "type": ["string", "null"] },
          "tokenBudget": { "type": ["integer", "null"] },
          "dryRun": { "type": ["boolean", "null"] },
          "state": {
            "type": ["object", "null"],
            "properties": { "seen": { "type": "array", "items": { "type": "string" } } }
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "state": { "type": "object" },
          "metrics": { "type": "object" },
          "checks": { "type": "array" }
        }
      }
    },
    "execute": {
      "description": "Alias of run for Proc-protocol v1 callers (ProcMon mandates execute); same input and result as run.",
      "input": { "type": "object", "properties": {} },
      "output": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "state": { "type": "object" },
          "metrics": { "type": "object" },
          "checks": { "type": "array" }
        }
      }
    },
    "terminate": {
      "description": "Stop and clean up.",
      "input": { "type": "object", "properties": {} }
    }
  },
  "execution": {
    "timeout": 600,
    "memoryLimit": "256Mi",
    "cpuLimit": "0.5"
  }
}
